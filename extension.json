{
  "apiVersion": 1,
  "id": "at365.watch",
  "name": "Applet.Watch.at365",
  "displayName": "Watch",
  "icon": "clock",
  "tagline": "いつもの画面に、見やすい時計を。",
  "version": "0.5.4",
  "minimumHostVersion": "0.105.8",
  "updateRepository": "yukichi-7sai/Applet.Watch.at365",
  "runtime": "native",
  "entry": "Applet.Watch.at365.exe",
  "description": "半透明の時計と日付をデスクトップに表示します。表示・文字サイズ・モニター・位置をそれぞれ設定できます。",
  "capabilities": [
    "ui",
    "settings"
  ],
  "commands": [
    {
      "id": "at365.watch.choose-font",
      "title": "フォントを選ぶ",
      "description": "Windowsのフォント選択から、時計と日付に使用するフォント名を選びます。"
    }
  ],
  "defaultKeybindings": [
    {
      "command": "at365.watch.settings.visible.toggle",
      "key": "Pause",
      "enabled": true,
      "when": {
        "scope": "global",
        "appletIds": []
      }
    }
  ],
  "settings": [
    {
      "key": "visible",
      "automation": true,
      "generateCommands": [
        "on",
        "off",
        "toggle"
      ],
      "title": "時計を表示",
      "type": "boolean",
      "default": false,
      "description": "日付とは個別に表示できます。[command:at365.watch.settings.visible.toggle] からも切り替えられます。"
    },
    {
      "key": "monitor",
      "title": "表示するモニター",
      "type": "select",
      "dynamic": true,
      "default": "primary",
      "options": [
        {
          "label": "メインモニター（自動）",
          "value": "primary"
        }
      ],
      "description": "Appletを有効にすると接続中のモニターを選べます。未接続の場合はメインに表示します。"
    },
    {
      "key": "alignment",
      "automation": true,
      "title": "時計の位置",
      "type": "select",
      "default": "top",
      "options": [
        {
          "value": "top",
          "label": "左上"
        },
        {
          "value": "top-center",
          "label": "中央上"
        },
        {
          "value": "top-right",
          "label": "右上"
        },
        {
          "value": "bottom",
          "label": "左下"
        },
        {
          "value": "bottom-center",
          "label": "中央下"
        },
        {
          "value": "bottom-right",
          "label": "右下"
        }
      ],
      "description": "選んだ画面の上端または下端で、左右・中央の配置を選びます。"
    },
    {
      "key": "horizontalMargin",
      "automation": true,
      "title": "左右の余白",
      "type": "number",
      "default": 20,
      "minimum": 0,
      "maximum": 1000,
      "step": 1,
      "description": "画面の左右端からの余白（DIP）。中央配置では左右の余白を等しく確保します。"
    },
    {
      "key": "verticalMargin",
      "automation": true,
      "title": "上下の余白",
      "type": "number",
      "default": 0,
      "minimum": 0,
      "maximum": 1000,
      "step": 1,
      "description": "選んだ上端／下端からの距離（DIP）。画面内に収まるよう調整します。"
    },
    {
      "key": "fontSize",
      "automation": true,
      "title": "時計の文字サイズ",
      "type": "number",
      "default": 420,
      "minimum": 48,
      "maximum": 720,
      "step": 1,
      "description": "文字サイズ（DIP）。画面幅が足りない場合は秒と同じ比率で縮小します。"
    },
    {
      "key": "fontFamily",
      "title": "フォント",
      "type": "string",
      "default": "",
      "description": "空欄の場合はSegoe UIで表示します。Windowsにインストール済みのフォント名を指定するか、「フォントを選ぶ」から変更できます。指定したフォントが未導入の場合もSegoe UIで表示し、保存済みの名前は保持します。",
      "minLength": 0,
      "maxLength": 256
    },
    {
      "key": "opacity",
      "automation": true,
      "title": "不透明度",
      "type": "number",
      "default": 0.4,
      "minimum": 0.05,
      "maximum": 1,
      "step": 0.05,
      "description": "時計と日付に共通で適用します。0.05〜1。"
    },
    {
      "key": "showSeconds",
      "automation": true,
      "generateCommands": [
        "on",
        "off",
        "toggle"
      ],
      "title": "秒を表示",
      "type": "boolean",
      "default": true,
      "description": "時・分の隣に秒を表示します。"
    },
    {
      "key": "showDate",
      "automation": true,
      "generateCommands": [
        "on",
        "off",
        "toggle"
      ],
      "title": "日付を表示",
      "type": "boolean",
      "default": false,
      "description": "時計とは個別に表示できます。[command:at365.watch.settings.showDate.toggle] からも切り替えられます。"
    },
    {
      "key": "secondsFontSize",
      "automation": true,
      "title": "秒の文字サイズ",
      "type": "number",
      "default": 210,
      "minimum": 24,
      "maximum": 720,
      "step": 1,
      "description": "文字サイズ（DIP）。時・分と独立して指定できます。"
    },
    {
      "key": "dateFontSize",
      "automation": true,
      "title": "日付の文字サイズ",
      "type": "number",
      "default": 210,
      "minimum": 24,
      "maximum": 720,
      "step": 1,
      "description": "文字サイズ（DIP）。画面幅が足りない場合は縮小します。"
    },
    {
      "key": "dateFormat",
      "automation": true,
      "title": "フォーマット",
      "type": "select",
      "default": "M/d ddd",
      "options": [
        {
          "value": "M/d ddd",
          "label": "月/日 曜日（例: 10/30 Fri）"
        },
        {
          "value": "yyyy/MM/dd",
          "label": "年/月/日（例: 2026/10/30）"
        },
        {
          "value": "yyyy-MM-dd",
          "label": "年-月-日（例: 2026-10-30）"
        },
        {
          "value": "M月d日",
          "label": "月日（例: 10月30日）"
        },
        {
          "value": "M月d日（ddd）",
          "label": "月日・曜日（例: 10月30日（金））"
        },
        {
          "value": "yyyy年M月d日（ddd）",
          "label": "年月日・曜日（例: 2026年10月30日（金））"
        }
      ]
    },
    {
      "key": "dateMonitor",
      "title": "表示するモニター",
      "type": "select",
      "dynamic": true,
      "default": "primary",
      "options": [
        {
          "label": "メインモニター（自動）",
          "value": "primary"
        }
      ],
      "description": "Appletを有効にすると接続中のモニターを選べます。未接続の場合はメインに表示します。"
    },
    {
      "key": "dateAlignment",
      "automation": true,
      "title": "日付の位置",
      "type": "select",
      "default": "top-right",
      "options": [
        {
          "value": "top",
          "label": "左上"
        },
        {
          "value": "top-center",
          "label": "中央上"
        },
        {
          "value": "top-right",
          "label": "右上"
        },
        {
          "value": "bottom",
          "label": "左下"
        },
        {
          "value": "bottom-center",
          "label": "中央下"
        },
        {
          "value": "bottom-right",
          "label": "右下"
        }
      ],
      "description": "選んだ画面の上端または下端で、左右・中央の配置を選びます。"
    },
    {
      "key": "dateHorizontalMargin",
      "automation": true,
      "title": "左右の余白",
      "type": "number",
      "default": 20,
      "minimum": 0,
      "maximum": 1000,
      "step": 1,
      "description": "画面の左右端からの余白（DIP）。中央配置では左右の余白を等しく確保します。"
    },
    {
      "key": "dateVerticalMargin",
      "automation": true,
      "title": "上下の余白",
      "type": "number",
      "default": 0,
      "minimum": 0,
      "maximum": 1000,
      "step": 1,
      "description": "選んだ上端／下端からの距離（DIP）。画面内に収まるよう調整します。"
    }
  ],
  "settingSections": [
    {
      "id": "appearance",
      "title": "共通の見た目",
      "settings": [
        "opacity",
        "fontFamily"
      ]
    },
    {
      "id": "clock",
      "title": "時計の表示",
      "settings": [
        "visible",
        "showSeconds",
        "fontSize",
        "secondsFontSize"
      ]
    },
    {
      "id": "position",
      "title": "時計の表示位置",
      "settings": [
        "monitor",
        "alignment",
        "horizontalMargin",
        "verticalMargin"
      ]
    },
    {
      "id": "date",
      "title": "日付の表示",
      "settings": [
        "showDate",
        "dateFormat",
        "dateFontSize"
      ]
    },
    {
      "id": "date-position",
      "title": "日付の表示位置",
      "settings": [
        "dateMonitor",
        "dateAlignment",
        "dateHorizontalMargin",
        "dateVerticalMargin"
      ]
    }
  ],
  "settingActions": [
    {
      "title": "フォントを選ぶ",
      "command": "at365.watch.choose-font",
      "settingKey": "fontFamily",
      "placement": "below",
      "appearance": "filled",
      "description": "時計と日付に共通のフォント名を適用します。文字サイズはそれぞれの表示設定で調整します。"
    }
  ]
}
